OPENROUTER_API_KEY=your_key_here


CK3_GAME_PATH=/path/to/SteamLibrary/steamapps/common/Crusader Kings III/game

# Optional: ck3-tiger binary; if unset, ``ck3-tiger`` on PATH is used
# CK3_TIGER_EXE=/path/to/ck3-tiger

# Optional: Qwen3 query-side instructions (vector search only; no reindex). Compare off vs on.
# EMBEDDING_QUERY_INSTRUCTION_ENABLED=false
# EMBEDDING_QUERY_INSTRUCTION_GAME=Given a user question about Crusader Kings III modding, retrieve relevant passages from game scripts
# EMBEDDING_QUERY_INSTRUCTION_WIKI=Given a user question about Crusader Kings III modding, retrieve relevant passages from wiki
